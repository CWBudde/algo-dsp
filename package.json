{
  "name": "algo-dsp-web",
  "private": true,
  "version": "0.0.0",
  "description": "Tooling for the algo-dsp web demo (web/). Not a published package; the library itself is a Go module.",
  "type": "module",
  "scripts": {
    "lint": "eslint web",
    "format": "prettier --write \"web/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"web/**/*.{js,css,html}\"",
    "check": "npm run lint && npm run format:check",
    "test": "playwright test --config web/test/playwright.config.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
